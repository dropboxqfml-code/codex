<Window x:Class="ATIVBatteryGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ATIVBatteryGuard.Controls"
        Title="ATIV Battery Guard · 940X3G" Width="750" Height="565"
        MinWidth="480" MinHeight="320" Background="#F3F5F8"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="15" Foreground="#17212B"
        WindowStartupLocation="Manual" Language="ko-KR" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ObservationGraphVisibility" />
        <Style x:Key="ManualProtectionStateButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#1D5CA8" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#1D5CA8" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#164C8E" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#123D73" />
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EDF1F5" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="BorderBrush" Value="#D4DDE7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
            <TextBlock Text="ATIV Battery Guard" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Margin="0,3,0,0">
                <TextBlock Text="Samsung 940X3G · 배터리 충전 관리" Foreground="#475569" Margin="0,0,16,0" />
                <TextBlock Text="{Binding ApplicationVersionText}" FontSize="12" Foreground="#64748B"
                           AutomationProperties.Name="프로그램 버전" />
            </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#E8EDF4" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                Visibility="{Binding HasStatusNotice, Converter={StaticResource ObservationGraphVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding SettingsWarning}" Foreground="#9C2F18"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <TabControl x:Name="MainSections" Style="{StaticResource NavigationTabs}" SelectedIndex="{Binding SelectedSection, Mode=TwoWay}"
                    Background="Transparent" BorderThickness="0" Padding="0,12,0,0"
                    AutomationProperties.Name="기능 선택">
            <TabItem Header="배터리" AutomationProperties.Name="배터리와 충전 제한">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Card}" Padding="18,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="새로 고침(_R)" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="배터리" Foreground="#475569" />
                                        <TextBlock Text="{Binding BatteryPercentText}" FontSize="32" FontWeight="SemiBold"
                                                   AutomationProperties.Name="Windows 측정 배터리 잔량" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="전원" Foreground="#475569" />
                                        <TextBlock Text="{Binding ExternalPowerText}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="상태" Foreground="#475569" />
                                        <TextBlock x:Name="BatteryChargeStateLabel" Text="{Binding ChargeStateText}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BatteryErrorText}" Foreground="#9C2F18" />
                                    </StackPanel>
                                </UniformGrid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="충전 제한" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ManualProtectionStateLabel" Text="{Binding ProtectionSummaryText}"
                                           FontSize="21" FontWeight="SemiBold" Margin="0,0,0,6"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding ProtectionActionHint}" Style="{StaticResource Detail}" />
                                <WrapPanel>
                                    <Button x:Name="ManualReadProtectionButton" Content="현재 설정 확인(_I)" Command="{Binding ManualReadProtectionCommand}" />
                                    <Button x:Name="ManualEnableProtectionButton" Content="80% 충전 제한(_E)" Style="{StaticResource ManualProtectionStateButton}"
                                            Tag="{Binding IsManual80PercentActive}"
                                            Command="{Binding ManualEnableProtectionCommand}" />
                                    <Button x:Name="ManualDisableProtectionButton" Content="제한 해제(_U)" Style="{StaticResource ManualProtectionStateButton}"
                                            Tag="{Binding IsManualLimitDisabled}" Command="{Binding ManualDisableProtectionCommand}" />
                                </WrapPanel>
                                <TextBlock x:Name="ManualProtectionNoticeLabel" Text="{Binding ManualProtectionNotice}" TextWrapping="Wrap"
                                           Foreground="#475569" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding ManualProtectionReadTimeText}" Foreground="#64748B" FontSize="13" Margin="0,8,0,0" />
                                <TextBlock Text="충전 제어 버튼을 누르면 Windows 관리자 확인이 나타납니다. 앱을 켜거나 배터리를 갱신할 때 설정을 자동으로 바꾸지 않습니다."
                                           Foreground="#64748B" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Expander Header="작업 결과와 문제 해결" Margin="0,12,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding SupportReason}" Style="{StaticResource Detail}" />
                                        <TextBlock Text="{Binding ManualProtectionPhaseText}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="ManualSaveResultButton" Content="작업 결과 저장" Command="{Binding ManualSaveResultCommand}" />
                                            <Button Content="저장 폴더 열기" Command="{Binding OpenSettingsFolderCommand}" />
                                        </WrapPanel>
                                        <TextBlock x:Name="ManualSaveStatusLabel" Text="{Binding ManualSaveStatusText}" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding ManualProtectionText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                                 AutomationProperties.Name="충전 제한 작업 상세" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="기록" AutomationProperties.Name="배터리 기록과 메모">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Margin="0,0,6,0">
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="새 배터리 기록" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="배터리 변화를 살펴보고 싶을 때 기록을 시작하세요. 약 10초마다 기록하며 최대 2시간까지 모읍니다. 끝나면 TXT로 저장할 수 있습니다."
                               Style="{StaticResource Detail}" />
                    <TextBlock Text="기록은 배터리 상태를 보여 주며 충전 설정을 바꾸지 않습니다."
                               Style="{StaticResource Detail}" />
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding ObservationStatusText}" FontWeight="SemiBold" Margin="0,0,16,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ObservationActive}" Value="True">
                                            <Setter Property="Foreground" Value="#00603A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ObservationSampleCount, StringFormat='기록 {0}건'}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ObservationGapCount, StringFormat='기록 공백 {0}건'}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ObservationPersistenceText}" TextWrapping="Wrap"
                               Foreground="#475569" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                        <Button x:Name="StartBatteryObservationButton" Content="기록 시작" Command="{Binding StartBatteryObservationCommand}" />
                        <Button Content="기록 중단" Command="{Binding StopBatteryObservationCommand}" />
                        <Button Content="기록 비우기" Command="{Binding ClearBatteryObservationCommand}" />
                        <Button x:Name="SaveBatteryObservationButton" Content="기록 TXT 저장" Command="{Binding SaveBatteryObservationCommand}" />
                        <Button x:Name="OpenBatteryObservationFolderButton" Content="저장 폴더 열기" Command="{Binding OpenSettingsFolderCommand}" />
                    </WrapPanel>
                    <TextBlock x:Name="BatteryObservationSaveStatus" Text="{Binding ObservationSaveStatusText}" TextWrapping="Wrap"
                               FontWeight="SemiBold" Margin="0,2,0,10" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#00603A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ObservationSaveFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#9C2F18" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#F8FAFC" BorderBrush="#D3DCE6" BorderThickness="1"
                            CornerRadius="6" Padding="8" Margin="0,0,0,12"
                            Visibility="{Binding ObservationGraphVisible, Converter={StaticResource ObservationGraphVisibility}}">
                        <StackPanel>
                            <controls:BatteryObservationChart x:Name="ObservationChart" Graph="{Binding ObservationGraph, Mode=OneWay}"
                                                              Height="180" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="관찰한 Windows 배터리 잔량 변화" />
                            <TextBlock x:Name="ObservationChartSelectionText" Text="{Binding SelectedPointText, ElementName=ObservationChart, Mode=OneWay}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#475569"
                                       AutomationProperties.Name="그래프 조작 안내와 선택 표본" />
                        </StackPanel>
                    </Border>
                    <Expander Header="기록 상세 보기" IsExpanded="False"
                              AutomationProperties.Name="새 배터리 기록 기록 펼치기">
                        <TextBox x:Name="BatteryObservationText" Text="{Binding ObservationText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" MaxHeight="280"
                                 VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,8,0,0"
                                 AutomationProperties.Name="새 배터리 기록 기록" />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="저장한 기록 열기" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button x:Name="OpenSavedObservationButton" Content="TXT 열기" Command="{Binding OpenSavedObservationCommand}" />
                        <Button x:Name="OpenComparisonObservationButton" Content="비교할 TXT 열기" Command="{Binding OpenComparisonObservationCommand}" />
                        <Button x:Name="CloseComparisonObservationButton" Content="비교 닫기" Command="{Binding CloseComparisonObservationCommand}" />
                        <Button Content="열린 기록 닫기" Command="{Binding CloseSavedObservationCommand}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="ImportObservationBundleButton" Content="기록·메모 불러오기" Command="{Binding ImportObservationBundleCommand}" />
                        <Button x:Name="ImportComparisonBundleButton" Content="비교할 묶음 불러오기" Command="{Binding ImportComparisonBundleCommand}" />
                    </WrapPanel>
                    <TextBlock Text="예전에 저장한 TXT를 열거나 .ativrecord 파일로 기록과 메모를 함께 불러오세요. 두 번째 기록을 열면 A/B로 비교할 수 있습니다."
                               TextWrapping="Wrap" Style="{StaticResource Detail}" />
                    <TextBlock Text="{Binding SavedObservationOpenStatus}" TextWrapping="Wrap" Margin="0,2,0,8"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SavedObservationOpenFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#9C2F18" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Expander Header="최근 기록" Margin="0,0,0,10">
                        <StackPanel>
                            <ListBox x:Name="RecentObservationsList" ItemsSource="{Binding RecentObservations}"
                                     SelectedItem="{Binding SelectedRecentObservation, Mode=TwoWay}" MaxHeight="180"
                                     HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="최근 관찰 기록 목록">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding IdentityText}" TextWrapping="Wrap" Foreground="#475569" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding NotePreview}" TextWrapping="Wrap" Foreground="#475569"
                                                       Visibility="{Binding HasNote, Converter={StaticResource ObservationGraphVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="OpenRecentObservationButton" Content="선택 기록 열기" Command="{Binding OpenRecentObservationCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding RecentObservationNotice}" TextWrapping="Wrap" Foreground="#9C2F18"
                               AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Visibility="{Binding SavedObservationVisible, Converter={StaticResource ObservationGraphVisibility}}">
                        <TextBlock Text="{Binding ComparisonAxisText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding ComparisonObservationVisible, Converter={StaticResource ObservationGraphVisibility}}" />
                        <TextBlock Text="{Binding SavedObservationTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SavedObservationIdentityText}" TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <TextBlock Text="{Binding SavedObservationSummary}" TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <TextBlock Text="{Binding SavedObservationNote.Preview}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,6" />
                        <Button x:Name="ExportObservationBundleButton" Content="기록·메모 함께 내보내기"
                                Command="{Binding ExportObservationBundleCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="입력 중인 메모도 함께 내보냅니다. 이 PC에 보관하려면 메모 저장을 누르세요."
                                   TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <Expander Header="메모 쓰기" Margin="0,0,0,10">
                            <StackPanel DataContext="{Binding SavedObservationNote}" Margin="0,8,0,0">
                                <TextBox x:Name="ANoteText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxLength="1000" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="기록 A 관찰 메모" />
                                <TextBlock Text="{Binding CharacterCountText}" Foreground="#475569" />
                                <WrapPanel>
                                    <Button x:Name="SaveANoteButton" Content="메모 저장" Command="{Binding SaveCommand}" />
                                    <Button Content="메모 다시 읽기" Command="{Binding ReloadCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Expander>
                        <Border Background="#F8FAFC" BorderBrush="#D3DCE6" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <controls:BatteryObservationChart x:Name="SavedObservationChart" IsSavedRecord="True"
                                                                  MinimumDomainSeconds="{Binding SavedObservationDomainSeconds}" Graph="{Binding SavedObservationGraph, Mode=OneWay}"
                                                                  Height="180" HorizontalAlignment="Stretch"
                                                                  AutomationProperties.Name="{Binding SavedObservationTitle, StringFormat='기록 {0}의 배터리 잔량 변화'}" />
                                <TextBlock Text="{Binding SelectedPointText, ElementName=SavedObservationChart, Mode=OneWay}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#475569"
                                           AutomationProperties.Name="저장 기록 그래프 조작 안내와 선택 표본" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ComparisonObservationVisible, Converter={StaticResource ObservationGraphVisibility}}">
                        <TextBlock Text="{Binding ComparisonObservationName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ComparisonObservationIdentityText}" TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <TextBlock Text="{Binding ComparisonObservationSummary}" TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <TextBlock Text="{Binding ComparisonObservationNote.Preview}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,6" />
                        <Button x:Name="ExportComparisonBundleButton" Content="비교 기록·메모 내보내기"
                                Command="{Binding ExportComparisonBundleCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="입력 중인 메모도 함께 내보냅니다. 이 PC에 보관하려면 메모 저장을 누르세요."
                                   TextWrapping="Wrap" Style="{StaticResource Detail}" />
                        <Expander Header="메모 쓰기" Margin="0,0,0,10">
                            <StackPanel DataContext="{Binding ComparisonObservationNote}" Margin="0,8,0,0">
                                <TextBox x:Name="BNoteText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxLength="1000" MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="기록 B 관찰 메모" />
                                <TextBlock Text="{Binding CharacterCountText}" Foreground="#475569" />
                                <WrapPanel>
                                    <Button x:Name="SaveBNoteButton" Content="메모 저장" Command="{Binding SaveCommand}" />
                                    <Button Content="메모 다시 읽기" Command="{Binding ReloadCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Expander>
                        <Border Background="#F8FAFC" BorderBrush="#D3DCE6" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <controls:BatteryObservationChart x:Name="ComparisonObservationChart" IsSavedRecord="True"
                                                                  MinimumDomainSeconds="{Binding SavedObservationDomainSeconds}"
                                                                  Graph="{Binding ComparisonObservationGraph, Mode=OneWay}"
                                                                  Height="180" HorizontalAlignment="Stretch"
                                                                  AutomationProperties.Name="{Binding ComparisonObservationName, StringFormat='기록 {0}의 배터리 잔량 변화'}" />
                                <TextBlock x:Name="ComparisonObservationSelectionText"
                                           Text="{Binding SelectedPointText, ElementName=ComparisonObservationChart, Mode=OneWay}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#475569"
                                           AutomationProperties.Name="비교 기록 B의 선택 표본" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="도움말·진단" AutomationProperties.Name="사용 방법과 문제 해결">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="어떻게 사용하나요?" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="전원을 자주 연결해 쓴다면" FontWeight="SemiBold" />
                                <TextBlock Text="배터리 탭에서 현재 설정을 확인한 뒤 80% 충전 제한을 선택하세요." Style="{StaticResource Detail}" Margin="0,4,0,12" />
                                <TextBlock Text="외출 전에 더 충전하고 싶다면" FontWeight="SemiBold" />
                                <TextBlock Text="제한 해제를 선택하세요. 실제 충전량과 속도는 배터리·충전기 상태에 따라 달라집니다." Style="{StaticResource Detail}" Margin="0,4,0,12" />
                                <TextBlock Text="기록과 메모를 옮기고 싶다면" FontWeight="SemiBold" />
                                <TextBlock Text="기록 탭에서 기록·메모 함께 내보내기를 누르세요. .ativrecord 파일 하나로 다른 위치에서 다시 열 수 있습니다." Style="{StaticResource Detail}" Margin="0,4,0,12" />
                                <TextBlock Text="알아 두세요" FontWeight="SemiBold" />
                                <TextBlock Text="배터리는 약 10초마다 갱신됩니다. 표시한 충전 제한 상태는 마지막 확인 결과입니다. 배터리 잔량이 80%라는 사실만으로 제한 설정을 판단하지 않습니다."
                                           Style="{StaticResource Detail}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="문제가 있을 때 진단하기" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="버튼이 계속 비활성화되거나 상태를 확인하지 못하면 장치 정보를 확인하세요. 진단은 충전 설정을 바꾸지 않고, 이 PC에서만 처리합니다."
                                           Style="{StaticResource Detail}" />
                                <WrapPanel>
                                    <Button x:Name="ReadDiagnosticsButton" Content="장치 정보 확인(_D)" Command="{Binding ShowDiagnosticsCommand}" />
                                    <Button Content="진단 복사(_C)" Command="{Binding CopyDiagnosticsCommand}" />
                                    <Button Content="진단 저장(_V)" Command="{Binding SaveDiagnosticsCommand}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,8">
                                    <TextBlock Text="모델 · " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DeviceModelText}" Margin="0,0,16,0" />
                                    <TextBlock Text="BIOS · " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DeviceBiosText}" />
                                </WrapPanel>
                                <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="230" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="장치 진단 결과" />
                                <Expander Header="추가 진단과 로그" Margin="0,12,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="기본 진단으로 원인을 찾기 어려울 때 사용하세요. 결과 파일을 공유하기 전에 내용을 확인할 수 있습니다." Style="{StaticResource Detail}" />
                                        <WrapPanel>
                                            <Button x:Name="CreateHardwareReportButton" Content="상세 진단 저장" Command="{Binding CreateHardwareReportCommand}" />
                                            <Button Content="저장 폴더 열기" Command="{Binding OpenSettingsFolderCommand}" />
                                            <Button Content="최근 작업 로그" Command="{Binding OpenLogCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding HardwareReportStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="StandardBatteryRequestSummary" Text="{Binding StandardBatteryRequestText}" Style="{StaticResource Detail}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
