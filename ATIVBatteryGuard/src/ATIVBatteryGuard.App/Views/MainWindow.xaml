<Window x:Class="ATIVBatteryGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATIV Battery Guard" Width="1120" Height="850"
        MinWidth="760" MinHeight="600" Background="#F1F3F5"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="15"
        Foreground="#17212B" WindowStartupLocation="CenterScreen"
        Language="ko-KR" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="26" KeyboardNavigation.TabNavigation="Continue">
        <StackPanel>
            <Grid Margin="0,4,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="ATIV Battery Guard" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="배터리 상태와 로컬 사용자 설정" Margin="0,8,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#006DC2" CornerRadius="6"
                        Padding="14,12" VerticalAlignment="Center">
                    <TextBlock Text="실제 충전 제한 미지원" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="상태 새로 고침(_R)"
                                Command="{Binding RefreshCommand}" Margin="10,0,0,16" />
                        <TextBlock Text="현재 배터리" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Grid Margin="0,4,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Windows 측정 잔량" />
                            <TextBlock Text="{Binding BatteryPercentText}" FontSize="40" FontWeight="SemiBold" Margin="0,10,0,0"
                                       AutomationProperties.Name="Windows 측정 배터리 잔량" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="외부 전원" />
                            <TextBlock Text="{Binding ExternalPowerText}" FontSize="23" FontWeight="SemiBold" Margin="0,17,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="충전 상태" />
                            <TextBlock x:Name="BatteryChargeStateLabel" Text="{Binding ChargeStateText}"
                                       FontSize="23" FontWeight="SemiBold" Margin="0,17,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="약 10초마다 조회합니다. 잔량 80% 또는 ‘충전 중 아님’은 충전 제한이 적용되었다는 증거가 아닙니다."
                               Style="{StaticResource Detail}" />
                    <TextBlock Text="{Binding BatteryErrorText}" Foreground="#9C2F18" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="실제 하드웨어 상태" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ActualHardwareState" Text="{Binding ActualModeText}"
                               FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding SupportReason}" Style="{StaticResource Detail}" />
                    <WrapPanel Margin="0,4,0,8">
                        <TextBlock Text="모델: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeviceModelText}" Margin="0,0,20,0" />
                        <TextBlock Text="BIOS: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeviceBiosText}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DeviceAssessmentText}" Style="{StaticResource Detail}" />
                    <TextBlock Text="저장된 사용자 선택값과 시뮬레이션 상태를 실제 장치 설정으로 표시하지 않습니다." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="사용자 선택값" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="실제 충전 설정을 바꾸지 않고, 사용할 희망 모드만 로컬에 기억합니다."
                               Style="{StaticResource Detail}" />
                    <WrapPanel>
                        <RadioButton x:Name="ProtectionChoice" Content="배터리 보호 ON · 80%(_P)" GroupName="DesiredMode"
                                     IsChecked="{Binding IsProtectionSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton x:Name="NormalChoice" Content="일반 모드 · 100%(_N)" GroupName="DesiredMode"
                                     IsChecked="{Binding IsNormalSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DesiredModeText}" Margin="0,0,0,12" FontWeight="SemiBold" />
                    <CheckBox Content="재부팅 후 복원 희망값 기억(_B)"
                              IsChecked="{Binding RestoreOnBoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="현재는 자동 실행이나 부팅 시 충전 제어를 수행하지 않습니다." Style="{StaticResource Detail}" />
                    <Button x:Name="SavePreferencesButton" Content="사용자 선택값 저장(_S)" Command="{Binding SaveCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding SettingsWarning}" Foreground="#9C2F18" />
                    <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="#FFF9EC" BorderBrush="#CFA44F">
                <StackPanel>
                    <TextBlock Text="시뮬레이션 — 실제 충전 제어 없음" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="MockSwitch" Content="개발용 시뮬레이션 켜기(_M)"
                              IsChecked="{Binding IsMockMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding MockModeText}" Style="{StaticResource Detail}" />
                    <TextBlock Text="{Binding MockActualModeText}" Margin="0,0,0,12" FontWeight="SemiBold" />
                    <Button x:Name="MockApplyButton" Content="선택값을 모의 상태에 적용(_A)"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Left" />
                    <TextBlock Text="실제 장치는 조작하지 않습니다. 프로그램을 다시 시작하면 시뮬레이션은 꺼집니다." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="읽기 전용 진단" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="모델·BIOS·Windows 정보와 배터리 및 삼성 인터페이스 정보를 조회합니다. 결과는 로컬에만 저장합니다."
                               Style="{StaticResource Detail}" />
                    <WrapPanel>
                        <Button Content="진단 정보 보기(_D)" Command="{Binding ShowDiagnosticsCommand}" />
                        <Button Content="진단 정보 복사(_C)" Command="{Binding CopyDiagnosticsCommand}" />
                        <Button Content="진단 정보 저장(_V)" Command="{Binding SaveDiagnosticsCommand}" />
                    </WrapPanel>
                    <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="250" VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,2,0,18"
                             AutomationProperties.Name="장치 진단 정보" />
                    <WrapPanel>
                        <Button x:Name="CreateHardwareReportButton" Content="진단 파일 만들기(_H)"
                                Command="{Binding CreateHardwareReportCommand}" />
                        <Button Content="진단 파일 위치 열기(_J)" Command="{Binding OpenSettingsFolderCommand}" />
                        <Button Content="로컬 로그 보기(_L)" Command="{Binding OpenLogCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HardwareReportStatus}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Samsung Settings 앱 분석 자료" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="설치된 Samsung Settings 앱의 프로그램 파일과 관련 DLL 복사본을 모읍니다. 파일을 실행하거나 충전 설정을 변경하지 않습니다."
                               Style="{StaticResource Detail}" />
                    <WrapPanel>
                        <Button Content="Settings 분석 파일 만들기(_Z)" Command="{Binding CreateSamsungBundleCommand}" />
                        <Button Content="파일 위치 열기(_O)" Command="{Binding OpenSettingsFolderCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SamsungBundleStatus}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding SamsungBundleFileName}" Margin="0,0,0,16" />
                    <TextBlock Text="ZIP에는 삼성 실행 파일·DLL이 포함될 수 있습니다. 생성 전에 확인을 받으며, 설정·로그·개인 문서는 포함하지 않습니다. 자동 전송하지 않습니다."
                               Style="{StaticResource Detail}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
